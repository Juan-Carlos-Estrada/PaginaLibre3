<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="607.0" prefWidth="1154.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.paginalib3.controller.UsuariosFXController">
    <padding>
        <Insets bottom="20" left="20" right="20" top="20" />
    </padding>
    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding>
                <Insets right="20" />
            </padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Gestión de Usuarios" />
            <TextField fx:id="txtIdUsuario" promptText="ID Usuario" />
            <TextField fx:id="txtUsername" promptText="Usuario" />
            <PasswordField fx:id="txtPassword" promptText="Contraseña (solo alta)" />
            <ComboBox fx:id="comboRol" prefWidth="260.0" promptText="Rol" />
            <CheckBox fx:id="chkActivo" text="Activo" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Crear" />
                <Button onAction="#handleActualizarRol" prefWidth="120" text="Guardar cambios" />
            </HBox>
            <HBox spacing="10">
                <Button onAction="#handleDesactivar" prefWidth="120" text="Desactivar" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" wrapText="true" />
        </VBox>
    </left>
</BorderPane>